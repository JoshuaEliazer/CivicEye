# ================================================================
# CivicEye - Global Environment Configuration (.env.example)
# Copy this file to .env and configure values before starting services
# ================================================================

# --- Environment & Ports ---
NODE_ENV=development
PORT=5000
FRONTEND_PORT=5173
ML_SERVICE_PORT=8000

# --- Database Configuration (MongoDB) ---
# For Local Development:
MONGODB_URI=mongodb://127.0.0.1:27017/civiceye
# For Docker Compose:
# MONGODB_URI=mongodb://mongodb:27017/civiceye

# --- Authentication (JWT) ---
# CRITICAL: Replace with a cryptographically secure random string in production
JWT_SECRET=replace_with_a_secure_random_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# --- Service Communication & Networking ---
# For Local Development:
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
# For Docker Compose:
# ML_SERVICE_URL=http://ml-service:8000

ML_SERVICE_TIMEOUT_MS=10000

# --- CORS Security ---
# Comma-separated list of allowed frontend origins in production
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173,http://localhost

# --- Local Media / Image Storage ---
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=uploads

# --- Ultralytics YOLO26 ML Service Configuration ---
CONFIDENCE_THRESHOLD=0.50
MODEL_PATH=model/yolo26n.pt

# --- Frontend Build Configuration (Vite) ---
# For Local Development:
VITE_API_URL=http://localhost:5000/api
# For Docker Nginx Proxy:
# VITE_API_URL=/api
